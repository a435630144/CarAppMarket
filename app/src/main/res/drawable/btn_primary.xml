<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_pressed" />
            <corners android:radius="@dimen/radius_btn" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/disabled" />
            <corners android:radius="@dimen/radius_btn" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/primary_gradient_start"
                android:endColor="@color/primary_gradient_end" />
            <corners android:radius="@dimen/radius_btn" />
        </shape>
    </item>
</selector>
