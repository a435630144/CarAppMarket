<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 5.0+：Material 主题 -->
    <style name="AppTheme" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <style name="AppActionBar" parent="android:Widget.Material.Light.ActionBar.Solid">
        <item name="android:background">@color/primary</item>
        <item name="android:titleTextStyle">@style/AppActionBarTitle</item>
    </style>

    <style name="AppActionBarTitle" parent="android:TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textColor">@color/text_white</item>
    </style>

    <!-- 深色模式：Material 暗色基底 -->
    <style name="AppThemeDark" parent="android:Theme.Material">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>
</resources>
